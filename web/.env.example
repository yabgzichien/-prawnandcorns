# Copy this file to .env.local inside web/ and fill in your own Gemini Developer API key.
# Never commit your actual key.
GEMINI_API_KEY=
# Set to a model available for your API key; see Google AI Studio's model access.
GEMINI_MODEL=gemini-4-hydrogen
# A visibly labelled fallback is used only if Hydrogen returns HTTP 503.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Keep remote access disabled until you add real authentication and rate limiting.
GEMINI_ENABLE_REMOTE=false
